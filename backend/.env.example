# CiviqOne / SAMAGRA Sovereign Backend Configuration
# Copy this file to backend/.env and update values for your local environment

PROJECT_NAME="CIVICONE / SAMAGRA Sovereign Backend"
API_V1_STR=/api/v1

# Security & JWT Configuration
# In production, replace with a 64+ char random string (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_key_in_production_sovereign_identity_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection URL
# SQLite default for zero-dependency local testing:
DATABASE_URL=sqlite:///./civicone_local.db

# PostgreSQL (Production / AWS RDS):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civiqone

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
