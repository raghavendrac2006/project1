# ==========================================
# CiviqOne Production Environment Configuration Template (AWS)
# ==========================================

# ------------------------------------------
# Frontend Environment Variables (Build time)
# ------------------------------------------
# In AWS Amplify: Set in App settings -> Environment variables
# In AWS S3/CloudFront: Injected during CI/CD build step
VITE_APP_TITLE=CiviqOne — Digital Civic Operating System
VITE_API_BASE_URL=https://api.civiqone.yourdomain.com/api/v1
VITE_USE_MOCK=false
VITE_API_TIMEOUT_MS=15000
VITE_ENABLE_ANALYTICS=true

# ------------------------------------------
# Backend Environment Variables (Runtime)
# ------------------------------------------
# In AWS App Runner / ECS: Set in Service configuration / Secrets Manager
PROJECT_NAME="CIVICONE / SAMAGRA Sovereign Backend"
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (Include your CloudFront / Amplify and custom domains)
BACKEND_CORS_ORIGINS=https://civiqone.yourdomain.com,https://d123456.cloudfront.net,https://main.d7890.amplifyapp.com

# Database Connection (AWS RDS PostgreSQL)
# Format: postgresql://[user]:[password]@[rds-endpoint]:5432/[database_name]
DATABASE_URL=postgresql://civic_admin:YourStrongPassword123!@civiqone-rds.c123456.us-east-1.rds.amazonaws.com:5432/civicone_db
